# Copy to requestarr.env, replace every CHANGE_ME value, then run:
#   docker compose --env-file requestarr.env up -d
# Never commit the filled-in file. The placeholders below are deliberately
# unusable: the server rejects them.

# Image tag. Pinned to an exact pre-release; do not use a floating tag.
REQUESTARR_TAG=v0.1.0-rc.3

# PostgreSQL password, used by both containers. Any characters are fine.
# Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_database_password

# The https address people use to reach Requestarr (your reverse proxy).
REQUESTARR_PUBLIC_URL=https://requestarr.example.com

# OPTIONAL. Leave these commented out: sign in as the local administrator first
# and set OIDC up in Settings, Authentication. Set them only to manage OIDC from
# the environment. If any one is set, all three come from here and override
# anything saved in Settings. Redirect URI: <public URL>/api/v1/auth/callback
# REQUESTARR_OIDC_ISSUER=https://id.example.com/realms/requestarr
# REQUESTARR_OIDC_CLIENT_ID=requestarr
# REQUESTARR_OIDC_CLIENT_SECRET=

# OPTIONAL initial password (12 to 128 characters) of the local administrator
# "admin", used only on a fresh database. You must change it at first sign-in.
# Left unset, a random one-time password is printed once in the container log.
# REQUESTARR_ADMIN_PASSWORD=

# OPTIONAL. Comma-separated CIDRs or addresses of your reverse proxy (for example
# 172.18.0.0/16). Only when the connection comes from one of these does Requestarr
# believe X-Forwarded-For when it tells clients apart for the sign-in delay. Leave
# empty unless a proxy stands in front and your proxy sets that header itself.
# REQUESTARR_TRUSTED_PROXIES=

# At least 32 bytes. Generate with: openssl rand -hex 32
REQUESTARR_SESSION_HMAC_SECRET=CHANGE_ME_session_secret

# Exactly 32 bytes as 64 hex characters or base64. Generate with:
# openssl rand -hex 32   (keep a backup: stored secrets cannot be read without it)
REQUESTARR_SECRETS_KEY=CHANGE_ME_master_key
