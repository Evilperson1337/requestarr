REQUESTARR_ENV=development
REQUESTARR_HTTP_ADDR=:8080
REQUESTARR_PUBLIC_URL=http://localhost:8080
# Built test stack only (make stack-up / stack-up-dev); ordinary run stays 8080.
# Imported OIDC callbacks allow 8080/18080. Register other exact callback URLs
# in the existing local Keycloak client before choosing another port.
REQUESTARR_STACK_HTTP_PORT=18080
REQUESTARR_LOG_LEVEL=debug
# Explicit opt-in, development only. Safe structured connection diagnostics for
# admins in Setup/Settings, not raw server/Docker logs. Restart clears history.
# make stack-up-dev enables this; make stack-up explicitly disables it.
REQUESTARR_DEV_LOGS=false

REQUESTARR_DATABASE_URL=postgres://requestarr:requestarr@postgres:5432/requestarr?sslmode=disable

# First-run bootstrap only. Use a long random value and remove/rotate after setup.
REQUESTARR_SETUP_TOKEN=change-me-before-first-run

# OIDC is required after setup. Dev defaults target the compose Keycloak realm.
REQUESTARR_OIDC_ISSUER=http://keycloak:8080/realms/requestarr
REQUESTARR_OIDC_CLIENT_ID=requestarr
REQUESTARR_OIDC_CLIENT_SECRET=change-me
REQUESTARR_SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Optional master key (D024): 32 bytes as 64 hex characters, or base64 that
# decodes to 32 bytes. Generate with `openssl rand -hex 32`. Lets admins save
# integration secrets (TMDB, IGDB, Apprise key, Jellyfin, Plex, RomM, Navidrome
# password) encrypted in Setup. An environment value below always wins over a
# saved one. Back this key up separately from the database; if it is lost or
# changed, saved secrets are unreadable and must be re-entered.
REQUESTARR_SECRETS_KEY=
# Extra hosts allowed to use http:// for library Sources, on top of the built-in
# private ranges: comma-separated CIDRs and hostname suffixes (docs/INTEGRATIONS.md).
# REQUESTARR_HTTP_ALLOWED_NETWORKS=
# TMDB API Read Access Token, not the v3 API key; omit any Bearer prefix.
REQUESTARR_TMDB_READ_TOKEN=
# Optional override. Otherwise Setup's saved non-secret ID applies on restart.
REQUESTARR_IGDB_CLIENT_ID=
REQUESTARR_IGDB_CLIENT_SECRET=
# Audible marketplace assumed for a bare audiobook ASIN: us, ca, uk, au, fr, de, jp, it, in or es (default us).
REQUESTARR_AUDIBLE_REGION=
# Optional operator-managed Jellyfin source. These values are trusted server
# configuration (never supplied by users); use HTTPS outside development.
REQUESTARR_JELLYFIN_URL=
REQUESTARR_JELLYFIN_API_KEY=
# Optional operator-managed Plex source (movies and TV). Trusted server
# configuration; use HTTPS outside development. The token stays server-side.
REQUESTARR_PLEX_URL=
REQUESTARR_PLEX_TOKEN=
# Optional operator-managed RomM source (games). Trusted server configuration;
# use HTTPS outside development. The bearer token (roms.read, platforms.read)
# stays server-side.
REQUESTARR_ROMM_URL=
REQUESTARR_ROMM_TOKEN=
# Optional operator-managed Navidrome/OpenSubsonic source (music only).
# Use a dedicated low-privilege Navidrome account; use HTTPS outside development.
REQUESTARR_NAVIDROME_URL=
REQUESTARR_NAVIDROME_USERNAME=
REQUESTARR_NAVIDROME_PASSWORD=
# Optional operator-managed Audiobookshelf source (audiobooks only; needs
# Audiobookshelf 2.26.0 or later). Use an API key of a dedicated Audiobookshelf
# user that can read the book libraries and has update/delete/upload turned off;
# use HTTPS outside development. Sent in the Authorization header only.
REQUESTARR_AUDIOBOOKSHELF_URL=
REQUESTARR_AUDIOBOOKSHELF_API_KEY=
REQUESTARR_OIDC_SCOPES=openid profile email
REQUESTARR_OIDC_GROUPS_CLAIM=groups

# Legacy provider names; the REQUESTARR_* variables above are the ones read.
TMDB_API_TOKEN=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
MUSICBRAINZ_CONTACT=

# Optional operator-managed global Apprise route; configure as a pair.
REQUESTARR_APPRISE_URL=http://apprise:8000
REQUESTARR_APPRISE_CONFIG_KEY=
