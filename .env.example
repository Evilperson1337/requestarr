REQUESTARR_ENV=development
REQUESTARR_HTTP_ADDR=:8080
REQUESTARR_PUBLIC_URL=http://localhost:8080
REQUESTARR_LOG_LEVEL=debug

REQUESTARR_DATABASE_URL=postgres://requestarr:requestarr@postgres:5432/requestarr?sslmode=disable

# First-run bootstrap only. Use a long random value and remove/rotate after setup.
REQUESTARR_SETUP_TOKEN=change-me-before-first-run

# OIDC is required after setup. Dev defaults target the compose Keycloak realm.
REQUESTARR_OIDC_ISSUER=http://keycloak:8080/realms/requestarr
REQUESTARR_OIDC_CLIENT_ID=requestarr
REQUESTARR_OIDC_CLIENT_SECRET=change-me
REQUESTARR_SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Optional master key (D024): 32 bytes as 64 hex characters or base64, e.g. `openssl rand -hex 32`.
# Lets admins save integration secrets (the TMDB token so far) encrypted in Setup.
# Back it up separately from the database; without it stored secrets are unreadable.
REQUESTARR_SECRETS_KEY=
REQUESTARR_TMDB_READ_TOKEN=
REQUESTARR_IGDB_CLIENT_ID=
REQUESTARR_IGDB_CLIENT_SECRET=
# Optional operator-managed Jellyfin source. These values are trusted server
# configuration (never supplied by users); use HTTPS outside development.
REQUESTARR_JELLYFIN_URL=
REQUESTARR_JELLYFIN_API_KEY=
# Optional operator-managed Plex source (movies and TV). Trusted server
# configuration; use HTTPS outside development. The token stays server-side.
REQUESTARR_PLEX_URL=
REQUESTARR_PLEX_TOKEN=
# Optional operator-managed RomM source (games). Trusted server configuration;
# use HTTPS outside development. The bearer token (roms.read, platforms.read)
# stays server-side.
REQUESTARR_ROMM_URL=
REQUESTARR_ROMM_TOKEN=
# Optional operator-managed Navidrome/OpenSubsonic source (music only).
# Use a dedicated low-privilege Navidrome account; use HTTPS outside development.
REQUESTARR_NAVIDROME_URL=
REQUESTARR_NAVIDROME_USERNAME=
REQUESTARR_NAVIDROME_PASSWORD=
REQUESTARR_OIDC_SCOPES=openid profile email
REQUESTARR_OIDC_GROUPS_CLAIM=groups

# Provider credentials are normally stored through setup/settings, not committed env files.
TMDB_API_TOKEN=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
MUSICBRAINZ_CONTACT=

# Optional operator-managed global Apprise route; configure as a pair.
REQUESTARR_APPRISE_URL=http://apprise:8000
REQUESTARR_APPRISE_CONFIG_KEY=
