REQUESTARR_ENV=development
REQUESTARR_HTTP_ADDR=:8080
REQUESTARR_PUBLIC_URL=http://localhost:8080
REQUESTARR_LOG_LEVEL=debug

# Required. Use localhost when running Requestarr on the host; use postgres in the devcontainer.
REQUESTARR_DATABASE_URL=postgres://requestarr:requestarr@localhost:5432/requestarr?sslmode=disable
# Integration tests are opt-in and never fall back to REQUESTARR_DATABASE_URL.
REQUESTARR_TEST_DATABASE_URL=postgres://requestarr:requestarr@localhost:5432/requestarr?sslmode=disable

# First-run bootstrap only: exactly 32 random bytes as canonical unpadded base64url.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# Missing or malformed values start safely with setup exchange locked.
REQUESTARR_SETUP_TOKEN=

# Independent at-rest encryption key: exactly 32 new random bytes as canonical
# unpadded base64url. Never reuse REQUESTARR_SETUP_TOKEN. Back this up separately
# with the database; replacing it is not an online V1 rotation mechanism.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
REQUESTARR_ENCRYPTION_KEY=

# OIDC is required after setup. Dev defaults target the compose Keycloak realm.
REQUESTARR_OIDC_ISSUER=http://keycloak:8080/realms/requestarr
REQUESTARR_OIDC_CLIENT_ID=requestarr
REQUESTARR_OIDC_CLIENT_SECRET=change-me
REQUESTARR_OIDC_SCOPES=openid profile email
REQUESTARR_OIDC_GROUPS_CLAIM=groups

# Provider credentials are normally stored through setup/settings, not committed env files.
TMDB_API_TOKEN=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
MUSICBRAINZ_CONTACT=

APPRISE_API_URL=http://apprise:8000
APPRISE_CONFIG_KEY=
