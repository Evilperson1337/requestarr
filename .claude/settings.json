{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "scripts/agent/snapshot.sh", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "scripts/agent/guard-bash.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
